# realgram-calling-relay — copy to .env.local on the deploy box and fill
# in real values. Never commit real values; this file must only ever
# contain placeholders.
#
# server.js loads .env.local itself at startup (see loadEnvLocal() near the
# top) so it's self-sufficient regardless of how the process manager starts
# it — pm2's saved snapshot does not persist ambient shell env, so relying
# on `pm2 start` inheriting these from the shell breaks on `pm2 resurrect`
# or a host reboot (this happened in production 2026-08-31).

# Public WS signaling port (nginx proxies /ws/call here).
CALLING_RELAY_PORT=8095

# Internal push-hook port. Loopback-only — never nginx-proxy this one.
CALLING_RELAY_INTERNAL_PORT=8096

# Signs/verifies per-connection vouchers. Must match the value PHP's
# call_sign_voucher() signs with (lib/calling.php's calling.relay_secret
# setting) — see README.md.
CALLING_RELAY_SECRET=

# Separate shared secret guarding POST /internal/push. Distinct from the
# voucher secret above.
CALLING_RELAY_INTERNAL_SECRET=
